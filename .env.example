# ============================================================
#  LoanGrosRaciste - configuration
#  Copie ce fichier en .env et remplis les valeurs.
# ============================================================

# --- Discord (bot complet) ---------------------------------
# Token du bot (https://discord.com/developers/applications -> Bot -> Reset Token)
DISCORD_TOKEN=
# ID du salon ou les alertes sont envoyees (clic droit sur le salon -> Copier l'ID,
# mode developpeur Discord active)
DISCORD_CHANNEL_ID=

# --- Source X (Twitter) via twscrape -----------------------
# Fichier de comptes X JETABLES, un par ligne au format:
#   username:password:email:email_password
# (NE METS PAS ton compte perso ici - risque de ban)
X_ACCOUNTS_FILE=accounts.txt
# Requetes/comptes a surveiller, separes par des ; (ex: actu virales, KOL crypto...)
# Exemples de requetes "Latest":
X_QUERIES=breaking;trending;just launched;memecoin

# --- Solana on-chain ---------------------------------------
# Cle Helius (free tier: https://dev.helius.xyz) - sert a l'analyse holders/supply/dev
HELIUS_API_KEY=
# DexScreener et Pump.fun ne demandent pas de cle.

# --- IA (Claude) : classification d'importance des actus ----
# Optionnel mais recommande. Sans cle, on retombe sur un scoring heuristique.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Reglages -----------------------------------------------
# Intervalle de scan en secondes
POLL_INTERVAL=30
# Score de buzz minimal (0-100) pour declencher une recherche de coin
MIN_BUZZ_SCORE=55
# Liquidite minimale (USD) d'un coin pour etre considere serieux
MIN_LIQUIDITY_USD=2000
# Fichier de wallets/handles de devs "connus" (JSON, voir known_devs.example.json)
KNOWN_DEVS_FILE=known_devs.json
