# ============================================================
#  LoanGrosRaciste
#  TOUT se configure depuis l'interface web (onglet "Reglages").
#  Ce fichier .env est OPTIONNEL : il ne sert qu'a definir des
#  valeurs par defaut au premier lancement. Copie-le en .env si
#  tu veux pre-remplir des valeurs.
# ============================================================

# Adresse du serveur web
HOST=127.0.0.1
PORT=8000

# Valeurs par defaut (modifiables ensuite dans l'UI) :
# X_QUERIES=breaking;trending;just launched;memecoin
# ANTHROPIC_MODEL=claude-sonnet-4-6
# POLL_INTERVAL=30
# MIN_BUZZ_SCORE=55
# MIN_LIQUIDITY_USD=2000

# Secrets (sinon a saisir dans l'UI) :
# HELIUS_API_KEY=
# ANTHROPIC_API_KEY=
# DISCORD_WEBHOOK_URL=
